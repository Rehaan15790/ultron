# Secrets - never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Runtime artifacts
logs/
ultron_memory.db
static/audio/
static/voice_samples/
*.mp3

# Test fixtures are part of the suite - without them those tests silently
# skip on a fresh clone instead of failing.
!tests/fixtures/*.mp3
